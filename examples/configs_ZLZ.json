{
  "batch_size": 6500,
  "nb_threads": 4,
  "modules": [
    {
      "path": "modules/edges.py",
      "names": [
        "m"
      ]
    },
    {
      "path": "modules/is_connected.py",
      "names": [
        "is_connected"
      ]
    },
    {
      "path": "modules/d_nm.py",
      "names": [
        "d_nm"
      ]
    },
    {
      "path": "modules/eci.py",
      "names": [
        "eci_G", "eci_E", "is_Enm"
      ],
      "dep": [
        "d_nm"
      ]
    }
  ],
  "aliases": [
    [
      "precond",
      "n-1 <= m and m <= n*(n-1)/2 and is_connected"
    ]
  ]
}
